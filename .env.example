# 이 파일을 `.env` 로 복사한 뒤 발급받은 값으로 채우세요. `.env` 는 git 에 커밋하지 않습니다.
# docker compose 가 자동으로 읽어 backend 컨테이너에 주입합니다.

# ── 국내 상세지도 타일 URL ({z}/{x}/{y} 플레이스홀더 그대로 둘 것) ──
# MapTiler 예:
#   TSD_KR_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=여기에_발급키
#   TSD_KR_MAP_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
# Mapbox 예:
#   TSD_KR_MAP_TILE_URL=https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/512/{z}/{x}/{y}@2x?access_token=여기에_토큰
#   TSD_KR_MAP_ATTRIBUTION=© Mapbox © OpenStreetMap
# self-host(tileserver-gl) 예:
#   TSD_KR_MAP_TILE_URL=http://map.내부도메인/styles/osm-bright/{z}/{x}/{y}.png
#   TSD_KR_MAP_ATTRIBUTION=© OpenStreetMap contributors

TSD_KR_MAP_TILE_URL=
TSD_KR_MAP_ATTRIBUTION=

# ── 구글 시트 연동 ──
# 1) Google Cloud 프로젝트에서 Drive API + Sheets API 사용 설정
# 2) 서비스 계정 생성 → JSON 키를  deploy/google-sa.json  으로 저장
# 3) 연동할 각 구글 시트를 서비스 계정 이메일(client_email)에 '뷰어' 공유
# 4) 아래 줄 주석 해제:
# TSD_GOOGLE_SA_JSON=/deploy/google-sa.json
